root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Two trailing spaces are a line break in Markdown
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[{*.bat,*.cmd,*.ps1}]
end_of_line = crlf

[{*.sh,gradlew}]
end_of_line = lf

# Kotlin source and Kotlin build scripts. ktlint reads this section.
# Code style: the Android Kotlin style guide (https://developer.android.com/kotlin/style-guide),
# which ADR-0006 adopts. ktlint names that style "android_studio"; the property and its values
# are described in the ktlint documentation
# (https://ktlint.github.io/ktlint/latest/rules/code-styles/), and are checked
# again at the first build.
# Column limit: the Android Kotlin style guide says "Code has a column limit of 100 characters."
# Enforcement: ktlintCheck runs in `check` and in the `android-static-analysis` job of CI, which
# first runs on the first pull request after the repository is published; review is the check
# until then.
[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 100
