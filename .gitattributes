# Normalize line endings in the repository; check out with each platform's default.
* text=auto

# Files that must keep their line endings
*.sh      text eol=lf
gradlew   text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.pdf      binary
*.jar      binary
*.aab      binary
*.apk      binary
*.onnx     binary
*.tflite   binary
*.keystore binary
*.jks      binary
*.docx     binary
*.pptx     binary
*.mp4      binary
